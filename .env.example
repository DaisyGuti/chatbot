# Copy to .env.local (gitignored) and fill in. The app calls OpenRouter only — never put an
# Anthropic key in this repo. Set a hard credit limit on the key at https://openrouter.ai/keys:
# /api/chat is public and the in-code guards are per-instance, so the key limit is the only
# ceiling a caller cannot route around. See CLAUDE.md § Secrets and plan.md §3.
OPENROUTER_API_KEY=

# Local testing only, no funded key needed — leave both unset for real usage. Run
# `npm run mock:openrouter` in a second terminal, then set these two to watch the real UI stream
# against canned replies instead of a live model. Never set OPENROUTER_BASE_URL in production.
# OPENROUTER_BASE_URL=http://localhost:8787/api/v1
# OPENROUTER_API_KEY=mock
